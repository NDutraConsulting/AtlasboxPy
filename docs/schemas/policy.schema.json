{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "validator_gateway recovery policy file",
  "description": "Maps a DomainError.code to an ordered list of recovery steps.",
  "type": "object",
  "additionalProperties": {
    "type": "array",
    "items": { "$ref": "#/definitions/RecoveryStep" }
  },
  "definitions": {
    "RecoveryStep": {
      "type": "object",
      "required": ["action"],
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "enum": ["retry", "redirect", "queue", "fail"]
        },
        "retry": { "$ref": "#/definitions/RetrySpec" },
        "redirect": { "$ref": "#/definitions/RedirectSpec" },
        "queue": { "$ref": "#/definitions/QueueSpec" }
      }
    },
    "RetrySpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "default": 3 },
        "backoff_base_seconds": { "type": "number", "minimum": 0, "default": 0.5 },
        "backoff_multiplier": { "type": "number", "minimum": 1, "default": 2.0 },
        "jitter": { "type": "boolean", "default": true }
      }
    },
    "RedirectSpec": {
      "type": "object",
      "required": ["target"],
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "string",
          "description": "Name registered via gateway.register_fallback() — never a dotted import path."
        }
      }
    },
    "QueueSpec": {
      "type": "object",
      "required": ["queue_name"],
      "additionalProperties": false,
      "properties": {
        "queue_name": { "type": "string" },
        "max_delay_seconds": { "type": ["integer", "null"] }
      }
    }
  }
}
